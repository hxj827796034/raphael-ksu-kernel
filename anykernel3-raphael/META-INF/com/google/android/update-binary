#!/sbin/sh
# AnyKernel3 update-binary — sourced by TWRP/OrangeFox
# This file just bootstraps the real script in anykernel.sh
OUTFD=/proc/self/fd/$2
ZIPFILE=$3

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

abort() {
  ui_print "Error: $1"
  exit 1
}

ui_print "==================================================="
ui_print "  AnyKernel3 — KSU for raphael"
ui_print "==================================================="

# Extract to /tmp/ak3
mkdir -p /tmp/ak3
cd /tmp/ak3
unzip -oq "$ZIPFILE" -d /tmp/ak3

# Pull in AnyKernel3 core helpers (if present in this zip)
[ -f /tmp/ak3/tools/ak3-core.sh ] && . /tmp/ak3/tools/ak3-core.sh

# Run the device-specific script
chmod 755 /tmp/ak3/anykernel.sh
. /tmp/ak3/anykernel.sh || abort "anykernel.sh failed"

ui_print "Done."
exit 0
